# ===========================================================================
# TiTaN — environment reference
#
# Copy to `.env` and edit. NOTHING here is required for a local demo: every
# value has a safe default and the secrets that must not be guessable
# (APP_SECRET, SESSION_SECRET, API_KEY_PEPPER, NODE_API_SECRET) are generated
# on first boot into  ${TITAN_STATE_DIR}/secrets.env  with mode 0600.
#
#   cp .env.example .env && docker compose up -d --build
#
# In production, set at least: DATABASE_URL, PUBLIC_URL, BOOTSTRAP_ADMIN_PASSWORD.
# ===========================================================================

# ------------------------------------------------------------------ runtime
ENV=production                 # production | development | test
DEBUG=false
HOST=0.0.0.0
PORT=8080                      # Railway/Fly inject PORT — never hardcode it
LOG_LEVEL=INFO
# LOG_DIR=/data/logs
APP_NAME=TiTaN
APP_SUBTITLE=مدیریت سرور و کانفیگ

# ------------------------------------------------------------------ database
# PostgreSQL (recommended, required for multi-replica deploys):
# DATABASE_URL=postgresql+asyncpg://titan:strong-password@postgres:5432/titan
# Local / single-node fallback (works out of the box, no server needed):
# DATABASE_URL=sqlite+aiosqlite:////data/titan.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
# Optional cache/queue for multi-worker installs (rate limits, hot settings):
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ security
# Leave empty in production — the panel generates strong values on first boot
# and persists them in ${TITAN_STATE_DIR}/secrets.env (0600).
APP_SECRET=
SESSION_SECRET=
API_KEY_PEPPER=
NODE_API_SECRET=               # shared secret for the panel → agent HMAC signature
COOKIE_NAME=titan_session
COOKIE_SECURE=                 # auto: true when ENV=production (HTTPS only)
COOKIE_DOMAIN=
SESSION_TTL_MINUTES=720
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=7           # failed logins before the account is locked
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=180
FORCE_PASSWORD_CHANGE=false
CORS_ORIGINS=*                 # set to your panel origin(s) in production

# ------------------------------------------------------------------ bootstrap
# The very first owner account. In production, if the password is empty the
# panel generates one and prints it once in the logs.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
TITAN_ALLOW_GENERATED_ADMIN_PASSWORD=1

# ------------------------------------------------------------------ URLs / SPA
PUBLIC_URL=                    # https://panel.example.com — used in links & installers
FRONTEND_DIST=/app/frontend/dist
SUBSCRIPTION_PATH=/sub
SUBSCRIPTION_TITLE=TiTaN
CORS_TRUSTED_HOSTS=            # comma separated Host header allow-list (optional)

# ------------------------------------------------------------------ storage
TITAN_STATE_DIR=/data/state    # MUST live on a persistent volume
BACKUP_DIR=/data/state/backups
CONFIG_BACKUP_KEEP=10          # per-engine rolling config backups on each node
METRIC_RETENTION_DAYS=14
LOG_RETENTION_DAYS=60

# ------------------------------------------------------------------ Xray / core
XRAY_PATH=/usr/local/bin/xray
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_ASSETS_PATH=/usr/local/share/xray
XRAY_API_PORT=10085
CLASH_API_PORT=9090
SINGBOX_PATH=/usr/local/bin/sing-box
NGINX_PATH=/usr/sbin/nginx
NGINX_CONFIG_PATH=/etc/nginx/nginx.conf
DEFAULT_PROTOCOL=vless
DEFAULT_TRANSPORT=ws
DEFAULT_PORT=443
DEFAULT_TLS_FINGERPRINT=chrome
DEFAULT_ALPN=h2,http/1.1

# ------------------------------------------------------------------ nodes/agent
NODE_AGENT_PORT=62050          # default agent port for new nodes
NODE_HEARTBEAT_TIMEOUT=180     # seconds without a heartbeat → node considered stale
NODE_OFFLINE_GRACE=300
AGENT_SCHEME=https             # use https once the node has a TLS certificate
AGENT_TIMEOUT_SECONDS=12
AGENT_RETRIES=3
AGENT_BACKOFF_BASE=1.6
AGENT_INSTALL_URL=             # override the installer URL handed to new nodes
SELF_HEAL_MAX_ATTEMPTS=5       # bounded auto-recovery (never an infinite loop)
MAX_NODES=200
MAX_USERS=20000

# ------------------------------------------------------------------ jobs
SCHEDULER_ENABLED=true
JOB_HEALTH_SECONDS=60
JOB_SSL_HOURS=6
JOB_CLEANUP_HOURS=24
JOB_BACKUP_HOURS=12

# ------------------------------------------------------------------ geo
GEOIP_PROVIDER=ipwhois         # ipwhois (keyless) | ipapi | mock (offline/test)
GEOIP_API_KEY=
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# ------------------------------------------------------------------ notifications
NOTIFY_ENABLED=false
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
NOTIFY_WEBHOOK_URL=

# ------------------------------------------------------------------ tests
# The test-suite sets its own isolated environment (see backend/tests/conftest.py).
