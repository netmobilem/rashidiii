{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "frontend/**",
      "docker/**",
      "Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/titan-entrypoint serve",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 45,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false
  },
  "environments": {
    "production": {
      "variables": {
        "ENV": "production",
        "PORT": "8080",
        "TITAN_STATE_DIR": "/data/state",
        "DATA_DIR": "/data",
        "GEOIP_PROVIDER": "ipwhois"
      }
    }
  }
}
